# Copy to .env and adjust as needed. Read by docker-compose.
PORT=3000
FEED_URL=https://witha.name/data/last.json
POLL_MINUTES=1

# Public URL of this dashboard (used in alert messages)
APP_URL=http://localhost:3000

# Optional: email alerts via SMTP. Leave SMTP_HOST empty to disable email
# (in-app + webhook alerts work without any of this).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set to true for implicit TLS (e.g. port 465); leave empty for STARTTLS (587)
SMTP_SECURE=

# Optional: social sign-in. Create OAuth apps and register the redirect URI
#   <APP_URL>/auth/google/callback   and/or   <APP_URL>/auth/github/callback
# Leave empty to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
