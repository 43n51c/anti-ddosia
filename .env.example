# Copy to .env and adjust as needed. Read by docker-compose.
PORT=3000
FEED_URL=https://witha.name/data/last.json
POLL_MINUTES=1

# History self-healing. On first boot with an empty DB the full archive is
# rebuilt automatically in the background; it is then rebuilt every
# BACKFILL_HOURS so gaps left by downtime / source outages fill in over time.
# Set AUTO_BACKFILL=0 to disable both (then run `node backfill.js all` yourself).
AUTO_BACKFILL=1
BACKFILL_HOURS=24
# Archive base URL for the backfill (dated config snapshots live here).
ARCHIVE_URL=https://witha.name/data/
# The backfill caches config bodies on disk (archived snapshots are immutable),
# so daily rebuilds only download NEW files. Defaults under data/archive-cache.
# ARCHIVE_CACHE_DIR=/app/data/archive-cache

# Periodic consistent DB snapshots (VACUUM INTO) with rotation. Set
# BACKUP_ENABLED=0 to disable. Snapshots land in data/backups by default.
BACKUP_ENABLED=1
BACKUP_HOURS=24
BACKUP_KEEP=7
# BACKUP_DIR=/app/data/backups

# Public URL of this dashboard (used in alert messages)
APP_URL=http://localhost:3000

# Optional: email alerts via SMTP. Leave SMTP_HOST empty to disable email
# (in-app + webhook alerts work without any of this).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set to true for implicit TLS (e.g. port 465); leave empty for STARTTLS (587)
SMTP_SECURE=

# Optional: social sign-in. Create OAuth apps and register the redirect URI
#   <APP_URL>/auth/google/callback   and/or   <APP_URL>/auth/github/callback
# Leave empty to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
